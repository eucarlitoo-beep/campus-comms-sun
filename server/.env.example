# Copie este arquivo para server/.env e preencha o que quiser usar.
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são necessários pra login,
# canais, mensagens etc. funcionarem — veja server/README.md.

# Porta do servidor (opcional)
PORT=4000

# --- Banco de dados e login (obrigatório para o chat funcionar) -------
# Painel do Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- GIFs -------------------------------------------------------------
# Preferencial: Tenor (Google). Grátis, leva ~2 minutos para criar:
# https://developers.google.com/tenor/guides/quickstart -> "Get an API key"
TENOR_API_KEY=

# Alternativa: GIPHY. Grátis, também leva ~2 minutos:
# https://developers.giphy.com/dashboard -> "Create an App" -> chave "Beta"
# Só é usada se TENOR_API_KEY estiver vazio.
GIPHY_API_KEY=
