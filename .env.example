# URL do servidor de chat (Socket.IO). Em desenvolvimento local, deixe como está.
# Em produção, aponte para onde você hospedou a pasta /server (ver server/README.md).
VITE_CHAT_SERVER_URL=http://localhost:4000

# Login/cadastro de verdade (Supabase). Veja server/README.md, seção
# "Banco de dados e login de verdade" — Project Settings > API no Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: servidor TURN, só necessário se os Círculos (chamada de áudio/
# vídeo) não conseguirem conectar em redes mais restritivas (comum em
# escolas). Veja server/README.md, seção "Círculos".
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
